generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  age       Int?
  createdAt DateTime @default(now())

  authCredential AuthCredential?

  devices             Device[]
  healthReadings      HealthReading[]
  environmentReadings EnvironmentReading[]
  predictions         RiskPrediction[]
  alerts              Alert[]
  emergencyEvents     EmergencyEvent[]
}

model Device {
  id        String   @id @default(uuid())
  deviceId  String   @unique
  type      String
  battery   Float?
  connected Boolean  @default(true)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthReading {
  id              String   @id @default(uuid())
  heartRate       Float?
  spo2            Float?
  bodyTemperature Float?
  activity        Float?
  timestamp       DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EnvironmentReading {
  id          String   @id @default(uuid())
  userId      String
  temperature Float?
  humidity    Float?
  aqi         Float?
  pm25        Float?
  event       String?
  timestamp   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RiskPrediction {
  id          String   @id @default(uuid())
  riskScore   Float
  riskLevel   String
  confidence  Float?
  explanation String?
  predictedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id          String   @id @default(uuid())
  type        String
  severity    String
  message     String
  acknowledged Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmergencyEvent {
  id          String   @id @default(uuid())
  eventType   String
  riskScore   Float?
  latitude    Float?
  longitude   Float?
  status      String
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}